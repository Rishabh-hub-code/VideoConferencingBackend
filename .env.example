# WebRTC Video Conferencing Backend Environment Configuration

# Model Configurations
WHISPER_MODEL_SIZE=small
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=4096
AUDIO_WINDOW_DURATION=3.0
MAX_AUDIO_SIZE_MB=50

# Diarization Configuration
DIARIZATION_MIN_SEGMENT_DURATION=0.5
DIARIZATION_MAX_SPEAKERS=10

# Translation Configuration
MAX_TRANSLATION_LENGTH=200
DEFAULT_SOURCE_LANGUAGE=hindi
DEFAULT_TARGET_LANGUAGE=english

# Performance Configuration
ENABLE_GPU=true
MODEL_CACHE_DIR=./models
MAX_CONCURRENT_PROCESSES=4

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
ENABLE_RATE_LIMITING=false
MAX_REQUESTS_PER_MINUTE=60

# Optional: HuggingFace Token for Private Models
# HF_TOKEN=your_huggingface_token_here

# Optional: Redis Configuration for Session Storage
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# Optional: Database Configuration (if persisting transcripts)
# DATABASE_URL=sqlite:///./transcripts.db